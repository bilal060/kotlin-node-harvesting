<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/primary_color"
    android:padding="32dp"
    tools:context=".MainActivity">

    <!-- App Logo -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_launcher_foreground"
        android:contentDescription="App Logo"
        android:layout_marginBottom="32dp"
        android:background="@drawable/logo_background"
        android:padding="20dp" />

    <!-- App Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dubai Discoveries"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginBottom="16dp"
        android:gravity="center" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Discover the magic of Dubai"
        android:textSize="18sp"
        android:textColor="@color/white_70"
        android:layout_marginBottom="48dp"
        android:gravity="center" />

    <!-- Device Code Display -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Device Code: 61250"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/accent_color"
        android:layout_marginBottom="48dp"
        android:background="@drawable/device_code_background"
        android:padding="16dp"
        android:gravity="center" />

    <!-- Permission Check Button -->
    <Button
        android:id="@+id/permissionCheckButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="🔐 Check Permissions and Continue"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/primary_button_background"
        android:textColor="@color/white"
        android:layout_marginBottom="32dp"
        android:onClick="onPermissionCheckButtonClick" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="@color/white"
        android:visibility="gone" />

    <!-- Status Text -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready to check permissions"
        android:textSize="16sp"
        android:textColor="@color/white_70"
        android:gravity="center"
        android:layout_marginTop="24dp" />

</LinearLayout>
